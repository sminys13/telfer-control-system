+      break;
+    case CMD_PROGRAM_CAPTURE_DRY_Z:
+      if (!sensorPairUsable(SENSOR_Z1, SENSOR_Z2)) { Serial.println(F("CAP DRY Z rejected: Z1+Z2 required")); return true; }
+      g_program.dryZ[0] = g_sensor[SENSOR_Z1].valueMm;
