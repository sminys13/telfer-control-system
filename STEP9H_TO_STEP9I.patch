+*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#071421,#091c2a);color:var(--text);font-family:Segoe UI,Arial,sans-serif}.topbar{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:15px 22px;background:#06111c;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:8}h1{margin:0 0 4px;font-size:23px}h2{margin:0;font-size:19px}h3{margin:0 0 8px;font-size:16px}.topbar p,.subtle{margin:4px 0 0;color:var(--muted);font-size:13px}.connection-box,.button-row,.status-strip,.assist-controls,.manual-command{display:flex;gap:8px;align-items:center;flex-wrap:wrap}button,input,select{font:inherit}button{border:1px solid #3a6580;background:#16334a;color:var(--text);border-radius:7px;padding:9px 13px;cursor:pointer}button:hover:not(:disabled){background:#1b4667}button:disabled{opacity:.4;cursor:not-allowed}.primary,.accent{background:#126fb2;border-color:#2d9bea}.danger{background:#9e2430;border-color:#ef5b65;font-weight:700}.pill{padding:7px 10px;border-radius:999px;font-weight:700;font-size:12px}.pill.offline{background:#472028;color:#ffc5c7}.pill.online{background:#123f2a;color:#9af0bf}.warning,.safety-banner{margin:12px 18px 0;padding:11px 15px;border-radius:8px}.warning{background:#5a252a;border:1px solid var(--bad)}.hidden{display:none}.safety-banner{background:#123247;border:1px solid #2d6888;color:#cfeafd}.tabs{display:flex;gap:4px;padding:12px 20px 0}.tab{border-bottom-left-radius:0;border-bottom-right-radius:0}.tab.active{background:#1b587d;border-color:#3b90bd}.tabpage{display:none}.tabpage.active{display:grid;gap:14px}main{padding:14px 20px 28px}.card{background:rgba(13,34,53,.96);border:1px solid var(--line);border-radius:10px;padding:15px;box-shadow:0 4px 18px rgba(0,0,0,.18)}.section-title-row{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:12px}.status-strip{justify-content:space-between;background:#091b2a;padding:9px 11px;border-radius:7px;color:var(--muted);margin-t