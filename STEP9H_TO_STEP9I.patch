++  if (abs32v6(diff) <= (int32_t)p.stopToleranceMm) return 0;
++  uint8_t cap = capPct;
++  if (cap < 1 || cap > 100) cap = p.maxPercent;
++  cap = minU8v6(cap, p.maxPercent);
++  uint8_t use = cap;
++  if (abs32v6(diff) <= (int32_t)p.slowdownDistanceMm) use = minU8v6(p.slowPercent, cap);
