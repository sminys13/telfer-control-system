+
+// Используем "_1_" буфер (экономия RAM).
+static U8G2_ST7565_ERC12864_1_4W_HW_SPI u8g2(U8G2_R0, PIN_LCD_CS, PIN_LCD_DC, PIN_LCD_RST);
+#if USE_ENCODER
